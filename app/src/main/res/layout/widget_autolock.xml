<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ibm_plex_mono_medium"
        android:letterSpacing="0.12"
        android:text="@string/app_name"
        android:textAllCaps="true"
        android:textColor="@color/pg_on_teal_deep_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_lock_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/exo2_variable"
        android:text="@string/lock_unknown"
        android:textColor="@color/pg_on_teal_deep"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_sans_variable"
        android:maxLines="2"
        android:text=""
        android:textColor="@color/pg_on_teal_deep_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_lock_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_button_bg"
        android:fontFamily="@font/instrument_sans_variable"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/action_lock_now"
        android:textColor="@color/pg_on_teal_deep"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
