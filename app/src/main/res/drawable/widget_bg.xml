<?xml version="1.0" encoding="utf-8"?>
<!--
    LEAVE/LOCK widget: flat teal-deep hero surface, top-right corner chamfered 24dp (the hero cut),
    other corners square, 1dp edge. No gradient, no glow.

    RemoteViews can't use ChamferShape, and a single vector would warp when the widget is resized,
    so the shape is built from layers: two edge-colour rectangles plus the corner triangle
    (widget_bg_corner) make the outline, then the same three pieces 1dp in, in the fill colour.

    Square corners: the widget root is @android:id/background with clipToOutline, which tells
    Launcher3 (Android 12+) not to round the widget's corners. The clip then follows this drawable's
    outline, which a LayerDrawable takes from its first layer, so the first layer is a transparent
    full-size rectangle (clip to the full bounds, i.e. no visible clip).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outline source for clipToOutline: full bounds, draws nothing -->
    <item>
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
    </item>
    <!-- Edge (outer outline) -->
    <item android:top="24dp">
        <shape android:shape="rectangle"><solid android:color="@color/pg_teal_deep_edge" /></shape>
    </item>
    <item android:right="24dp">
        <shape android:shape="rectangle"><solid android:color="@color/pg_teal_deep_edge" /></shape>
    </item>
    <!-- Corner: edge triangle and its 1dp-inset fill -->
    <item android:gravity="top|end" android:width="24dp" android:height="24dp"
        android:drawable="@drawable/widget_bg_corner" />
    <!-- Fill, 1dp inside the edge -->
    <item android:top="24dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/pg_teal_deep" /></shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="24dp" android:bottom="1dp">
        <shape android:shape="rectangle"><solid android:color="@color/pg_teal_deep" /></shape>
    </item>
</layer-list>
